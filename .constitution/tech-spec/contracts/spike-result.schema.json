{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burlmd.local/schemas/spike-result.schema.json",
  "title": "burlmd decision Spike result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "spikeId", "generatedAt", "corpus", "candidates", "gates", "runs", "recommendation", "unresolved"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "spikeId": { "pattern": "^SPK-[A-Z]+-[A-Z][0-9]{3}$", "type": "string" },
    "generatedAt": { "format": "date-time", "type": "string" },
    "corpus": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "configuration"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "configuration": { "type": "object" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "name", "passed", "evidence"],
        "properties": {
          "candidate": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "host", "toolchain", "commandResults", "measurements", "artifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "osVersion", "architecture", "filesystem"],
            "properties": {
              "os": { "type": "string", "minLength": 1 },
              "osVersion": { "type": "string", "minLength": 1 },
              "distribution": { "type": "string", "minLength": 1 },
              "releaseChannel": { "enum": ["stable", "lts", "other"] },
              "architecture": { "type": "string", "minLength": 1 },
              "filesystem": { "type": "string", "minLength": 1 }
            }
          },
          "toolchain": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "commandResults": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "exitCode", "stdout", "stderr"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
                "stdout": { "type": "string", "minLength": 1 },
                "stderr": { "type": "string", "minLength": 1 }
              }
            }
          },
          "measurements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate", "name", "value", "unit", "samples"],
              "properties": {
                "candidate": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "value": { "type": "number" },
                "unit": { "type": "string", "minLength": 1 },
                "samples": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "kind", "bytes", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 },
                "bytes": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "recommendation": { "type": "string", "minLength": 1 },
    "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
