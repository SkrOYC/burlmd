{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burlmd.local/schemas/spike-result.schema.json",
  "title": "burlmd decision Spike result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "spikeId", "generatedAt", "corpus", "candidates", "gates", "runs", "recommendation", "unresolved"],
  "properties": {
    "schemaVersion": { "const": 14 },
    "spikeId": { "pattern": "^SPK-[A-Z]+-[A-Z][0-9]{3}$", "type": "string" },
    "generatedAt": { "$comment": "The mandatory result validator must semantically parse this value as RFC 3339 and reject impossible calendar dates; this pattern checks shape only.", "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "corpus": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "configuration"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "configuration": { "type": "object" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "name", "passed", "evidence"],
        "properties": {
          "candidate": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "role": { "enum": ["linux-x86_64-performance", "macos-26-performance-visual", "macos-current-stable", "macos-repeat-construction", "macos-previous-stable"] } }, "required": ["role"] },
            "then": { "properties": { "host": { "type": "object", "required": ["profile"], "properties": { "profile": {} } } } }
          }
        ],
        "required": ["id", "role", "inputContext", "host", "toolchain", "commandResults", "measurements", "artifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "inputContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repositoryRevision", "repositoryTreeSha256", "lockfiles", "contractSha256", "schemaSha256", "probeSourceTreeSha256", "probeBinarySha256", "corpusManifestSha256"],
            "properties": {
              "repositoryRevision": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "repositoryTreeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "lockfiles": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              },
              "contractSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "probeSourceTreeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "probeBinarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "corpusManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostFingerprint", "os", "osVersion", "architecture", "filesystem"],
            "properties": {
              "hostFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "os": { "type": "string", "minLength": 1 },
              "osVersion": { "type": "string", "minLength": 1 },
              "distribution": { "type": "string", "minLength": 1 },
              "releaseChannel": { "enum": ["stable", "lts", "other"] },
              "architecture": { "type": "string", "minLength": 1 },
              "filesystem": { "type": "string", "minLength": 1 },
              "profile": {
                "type": "object",
                "additionalProperties": false,
                "required": ["runnerLabel", "imageOS", "imageVersion", "cpuModel", "logicalCpuCount", "memoryBytes", "storageBytes", "logicalViewportWidth", "logicalViewportHeight", "logicalViewportRefreshHz", "logicalViewportVerified", "roles"],
                "properties": {
                  "runnerLabel": { "enum": ["ubuntu-24.04", "macos-26", "macos-15"] },
                  "imageOS": { "type": "string", "minLength": 1 },
                  "imageVersion": { "type": "string", "minLength": 1 },
                  "cpuModel": { "type": "string", "minLength": 1 },
                  "logicalCpuCount": { "type": "integer", "minimum": 1 },
                  "memoryBytes": { "type": "integer", "minimum": 1 },
                  "storageBytes": { "type": "integer", "minimum": 1 },
                  "logicalViewportWidth": { "const": 1920 },
                  "logicalViewportHeight": { "const": 1080 },
                  "logicalViewportRefreshHz": { "const": 60 },
                  "logicalViewportVerified": { "const": true },
                  "roles": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["common-functional", "common-functional-compatibility", "performance", "linux-platform-regression", "macos-authoritative-visual"] }
                  }
                }
              }
            }
          },
          "toolchain": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "runtimeEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["environment", "os", "distribution", "version", "architecture", "captureSource"],
              "properties": {
                "environment": { "type": "string", "minLength": 1 },
                "os": { "type": "string", "minLength": 1 },
                "distribution": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "architecture": { "type": "string", "minLength": 1 },
                "captureSource": { "const": "system-api-inside-guest" }
              }
            }
          },
          "commandResults": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "exitCode", "stdout", "stderr"],
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
                "stdout": { "type": "string" },
                "stderr": { "type": "string" }
              }
            }
          },
          "measurements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate", "name", "value", "unit", "samples"],
              "properties": {
                "candidate": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "value": { "type": "number" },
                "unit": { "type": "string", "minLength": 1 },
                "samples": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "kind", "bytes", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 },
                "bytes": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "recommendation": { "type": "string", "minLength": 1 },
    "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
