{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "linux-capacity-record.schema.json",
  "title": "BURL-O001 Linux capacity record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ticketId",
    "roleId",
    "runIdentity",
    "phaseId",
    "event",
    "sequence",
    "observedAt",
    "monotonicNanoseconds",
    "filesystem",
    "inventoryAllocatedBytes",
    "filesystemAvailableBytes",
    "outputRootsAllocatedBytes",
    "thresholds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ticketId": { "const": "BURL-O001" },
    "roleId": { "const": "linux-x86_64" },
    "runIdentity": {
      "type": "string",
      "pattern": "^managed:[0-9a-f]{32}$"
    },
    "phaseId": {
      "type": "string",
      "enum": [
        "linux-capacity-admission",
        "linux-flake-check",
        "linux-build",
        "linux-flake-install",
        "linux-appimage-installed-probe",
        "linux-flake-installed-probe",
        "ubuntu-22.04-x86_64",
        "ubuntu-24.04-x86_64",
        "ubuntu-26.04-x86_64",
        "debian-12-x86_64",
        "debian-13-x86_64",
        "linux-copy-candidate-outputs",
        "linux-write-role-manifest",
        "linux-compress-role-bundle",
        "linux-finalize-upload-inputs"
      ]
    },
    "event": {
      "type": "string",
      "enum": ["initial", "precheck", "postcheck"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 28
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{9}Z$"
    },
    "monotonicNanoseconds": {
      "type": "integer",
      "minimum": 0
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "mountPoint", "type", "totalBytes"],
      "properties": {
        "device": { "type": "string", "minLength": 1 },
        "mountPoint": { "type": "string", "pattern": "^/" },
        "type": { "type": "string", "minLength": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "inventoryAllocatedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "filesystemAvailableBytes": {
      "type": "integer",
      "minimum": 0
    },
    "outputRootsAllocatedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialAllocatedCeilingBytes",
        "initialAvailableFloorBytes",
        "phaseAvailableFloorBytes",
        "capacityRecordReserveBytes"
      ],
      "properties": {
        "initialAllocatedCeilingBytes": { "const": 10000000000 },
        "initialAvailableFloorBytes": { "const": 4000000000 },
        "phaseAvailableFloorBytes": { "const": 1000000000 },
        "capacityRecordReserveBytes": { "const": 1048576 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event": { "const": "initial" } },
        "required": ["event"]
      },
      "then": {
        "properties": {
          "phaseId": { "const": "linux-capacity-admission" },
          "sequence": { "const": 0 }
        }
      },
      "else": {
        "properties": {
          "phaseId": {
            "not": { "const": "linux-capacity-admission" }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phaseId": { "const": "linux-capacity-admission" }
        },
        "required": ["phaseId"]
      },
      "then": {
        "properties": { "event": { "const": "initial" } }
      },
      "else": {
        "properties": {
          "event": { "enum": ["precheck", "postcheck"] }
        }
      }
    }
  ]
}
