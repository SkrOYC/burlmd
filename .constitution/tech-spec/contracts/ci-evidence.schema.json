{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burlmd.local/schemas/ci-evidence.schema.json",
  "title": "burlmd managed CI aggregate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedIdentity", "expectedIdentitySha256", "expectedIdentityArtifact", "generatedAt", "mode", "status", "roleEvidence", "compatibilityStage", "coordinatorExecution", "aggregationChecks", "rejectionReasons"],
  "properties": {
    "schemaVersion": { "const": 18 },
    "expectedIdentity": { "$ref": "ci-role-evidence.schema.json#/$defs/expectedIdentity" },
    "expectedIdentitySha256": { "$ref": "#/$defs/sha256" },
    "expectedIdentityArtifact": {
      "$comment": "Semantic validation requires the accepted artifact name to equal managed-evidence-expected- plus expectedIdentity.artifactNonce. Rejected reports may use null when this artifact is missing.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactObservation" }]
    },
    "generatedAt": { "$ref": "#/$defs/rfc3339" },
    "mode": { "const": "trusted-anchor-local" },
    "status": { "enum": ["accepted", "rejected"] },
    "roleEvidence": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/enrichedRoleEvidence" } },
    "compatibilityStage": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/compatibilityStageAggregate" }] },
    "coordinatorExecution": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/coordinatorExecution" }] },
    "aggregationChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rolesComplete", "identityCompared", "trustAnchorVerified", "trustedSurfacesUnchanged", "sourceAllowlistVerified", "evidenceProfileVerified", "roleResultsPassed", "candidatePlacementVerified", "candidateTopologyVerified", "candidateLabelsVerified", "candidateCompletionVerified", "sealOriginsAuthenticated", "hostedOriginVerified", "compatibilityStageVerified", "artifactNamesVerified", "artifactIntegrityVerified", "bundleContentsVerified", "filesystemEvidenceVerified", "imageVersionsCompatible"],
      "properties": {
        "rolesComplete": { "type": "boolean" },
        "identityCompared": { "type": "boolean" },
        "trustAnchorVerified": { "type": "boolean" },
        "trustedSurfacesUnchanged": { "type": "boolean" },
        "sourceAllowlistVerified": { "type": "boolean" },
        "evidenceProfileVerified": { "type": "boolean" },
        "roleResultsPassed": { "type": "boolean" },
        "candidatePlacementVerified": { "$comment": "True means the static trusted workflow and observed job match the expected candidate placement. This guard is not cryptographic hosted-origin proof.", "type": "boolean" },
        "candidateTopologyVerified": { "$comment": "True means the static candidate-to-seal topology matches expected identity. This guard is not cryptographic hosted-origin proof.", "type": "boolean" },
        "candidateLabelsVerified": { "$comment": "True means REST labels match expected identity. Labels are noncryptographic and can be customized on self-hosted runners.", "type": "boolean" },
        "candidateCompletionVerified": { "$comment": "True means the exact candidate job reached completed success. Completion is a runtime guard, not cryptographic hosted-origin proof.", "type": "boolean" },
        "sealOriginsAuthenticated": { "$comment": "True means every sealing job has verified attestation provenance bound to its signer, source, run, attempt, check-run ID, and runner_environment claim.", "type": "boolean" },
        "hostedOriginVerified": { "$comment": "This value refers only to fresh sealing-job origin authenticated by verified attestation provenance. It never describes candidate hosted origin.", "type": "boolean" },
        "compatibilityStageVerified": { "oneOf": [{ "type": "null" }, { "type": "boolean" }] },
        "artifactNamesVerified": { "type": "boolean" },
        "artifactIntegrityVerified": { "$comment": "True requires an action-to-REST digest match for every receipt artifact as well as every expected, candidate, sealed, compatibility-stage, and producer-lineage artifact.", "type": "boolean" },
        "bundleContentsVerified": { "type": "boolean" },
        "filesystemEvidenceVerified": { "$comment": "The aggregator must require every enriched role manifest to carry a non-empty observed environment.filesystem string, compare the exact candidate/sealed/aggregated manifest value, and reject a missing, empty, or changed value.", "type": "boolean" },
        "imageVersionsCompatible": { "type": "boolean" }
      }
    },
    "rejectionReasons": { "type": "array", "items": { "$ref": "#/$defs/rejectionReason" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "roleEvidence": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "$comment": "Role-manifest validation applies the conditional viewport requirement from ci-role-evidence.schema.json. Aggregate acceptance requires every role but does not require viewport.verified for every role.",
            "allOf": [
              { "contains": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "linux-x86_64" } } } } } } } },
              { "contains": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "macos-26-arm64" } } } } } } } },
              { "contains": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "macos-15-arm64" } } } } } } } }
            ]
          },
          "expectedIdentityArtifact": {
            "allOf": [
              { "$ref": "#/$defs/artifactObservation" },
              { "type": "object", "properties": { "artifactName": { "type": "string", "pattern": "^managed-evidence-expected-[0-9a-f]{32}$" } } }
            ]
          },
          "aggregationChecks": { "type": "object", "properties": {
            "rolesComplete": { "const": true },
            "identityCompared": { "const": true },
            "trustAnchorVerified": { "const": true },
            "trustedSurfacesUnchanged": { "const": true },
            "sourceAllowlistVerified": { "const": true },
            "evidenceProfileVerified": { "const": true },
            "roleResultsPassed": { "const": true },
            "candidatePlacementVerified": { "const": true },
            "candidateTopologyVerified": { "const": true },
            "candidateLabelsVerified": { "const": true },
            "candidateCompletionVerified": { "const": true },
            "sealOriginsAuthenticated": { "const": true },
            "hostedOriginVerified": { "const": true },
            "artifactNamesVerified": { "const": true },
            "artifactIntegrityVerified": { "const": true },
            "bundleContentsVerified": { "const": true },
            "filesystemEvidenceVerified": { "const": true },
            "imageVersionsCompatible": { "const": true }
          } },
          "rejectionReasons": { "type": "array", "maxItems": 0 }
        },
        "allOf": [
          {
            "if": { "properties": { "expectedIdentity": { "type": "object", "properties": { "ticketIdentity": { "const": "BURL-O001" } }, "required": ["ticketIdentity"] } }, "required": ["expectedIdentity"] },
            "then": {
              "properties": {
                "compatibilityStage": { "$ref": "#/$defs/compatibilityStageAggregate" },
                "aggregationChecks": { "type": "object", "properties": { "compatibilityStageVerified": { "const": true } } }
              }
            },
            "else": {
              "properties": {
                "compatibilityStage": { "type": "null" },
                "aggregationChecks": { "type": "object", "properties": { "compatibilityStageVerified": { "type": "null" } } }
              }
            }
          },
          {
            "if": { "properties": { "expectedIdentity": { "type": "object", "properties": { "ticketIdentity": { "enum": ["BURL-M003", "BURL-G011", "BURL-P002", "BURL-O011", "BURL-O012", "BURL-O013"] } } } } },
            "then": { "properties": { "coordinatorExecution": { "type": "null" } } },
            "else": { "properties": { "coordinatorExecution": {
              "allOf": [
                { "$ref": "#/$defs/coordinatorExecution" },
                { "type": "object", "properties": {
                  "networkIsolated": { "const": true },
                  "credentialsSanitized": { "const": true },
                  "descriptorsClosed": { "const": true },
                  "emptyUserState": { "const": true },
                  "inputsReadOnly": { "const": true },
                  "outputOnlyWritable": { "const": true },
                  "forbiddenToolsAbsent": { "const": true },
                  "credentialCanariesAbsent": { "const": true },
                  "representativeResultPassed": { "const": true }
                } }
              ]
            } } }
          }
        ]
      },
      "else": { "properties": { "rejectionReasons": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rfc3339": {
      "$comment": "The aggregator must parse this value and reject impossible calendar dates; this pattern checks shape only.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "role": { "enum": ["linux-x86_64", "macos-26-arm64", "macos-15-arm64"] },
    "signerWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowPath", "jobWorkflowRef", "jobWorkflowSha", "builderId"],
      "properties": {
        "workflowPath": { "type": "string", "minLength": 1 },
        "jobWorkflowRef": { "type": "string", "minLength": 1 },
        "jobWorkflowSha": { "$ref": "#/$defs/gitSha" },
        "builderId": { "type": "string", "pattern": "^https://github\\.com/SkrOYC/burlmd/\\.github/workflows/.+@refs/heads/master$" }
      }
    },
    "candidatePlacementObservation": {
      "$comment": "The coordinator constructs this noncryptographic runtime-guard observation from trusted workflow source and the versioned job API. REST labels, placement, topology, and completion fail closed but do not prove GitHub-hosted origin. This object deliberately has no runnerEnvironment field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "checkRunId", "workflowJobKey", "workflowPath", "expectedRunnerLabel", "runnerLabels", "placementFixedByTrustedWorkflow", "topologyVerified", "labelVerified", "status", "conclusion", "completionVerified"],
      "properties": {
        "jobId": { "type": "integer", "minimum": 1 },
        "checkRunId": { "type": "integer", "minimum": 1 },
        "workflowJobKey": { "const": "candidate" },
        "workflowPath": { "enum": [".github/workflows/ci-role-linux-x86-64.yml", ".github/workflows/ci-role-macos-26-arm64.yml", ".github/workflows/ci-role-macos-15-arm64.yml"] },
        "expectedRunnerLabel": { "enum": ["ubuntu-24.04", "macos-26", "macos-15"] },
        "runnerLabels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "placementFixedByTrustedWorkflow": { "const": true },
        "topologyVerified": { "const": true },
        "labelVerified": { "const": true },
        "status": { "const": "completed" },
        "conclusion": { "const": "success" },
        "completionVerified": { "const": true }
      }
    },
    "sealingJobOrigin": {
      "$comment": "The coordinator resolves this job through the pre-completion receipt locator after the attempt completes. Verified attestation provenance binds runnerEnvironment, signer, source, run, attempt, and check-run ID. This is the only job-origin object that can authenticate GitHub-hosted origin.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "checkRunId", "workflowJobKey", "runnerLabels", "runnerEnvironment", "status", "conclusion", "hostedOriginVerified"],
      "properties": {
        "jobId": { "type": "integer", "minimum": 1 },
        "checkRunId": { "type": "integer", "minimum": 1 },
        "workflowJobKey": { "const": "seal" },
        "runnerLabels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "runnerEnvironment": { "const": "github-hosted" },
        "status": { "const": "completed" },
        "conclusion": { "const": "success" },
        "hostedOriginVerified": { "const": true }
      }
    },
    "artifactObservation": {
      "$comment": "The pinned upload action emits uploadActionDigest as bare lowercase hexadecimal. The REST API and this aggregate use artifactDigest in canonical sha256:<hex> form. Semantic validation must require artifactDigest to equal 'sha256:' concatenated with uploadActionDigest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactName", "uploadActionDigest", "artifactDigest"],
      "properties": {
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": {
          "$comment": "The aggregator also requires this exact name to use the expected role and artifactNonce. The restricted alphabet excludes every character rejected by the pinned upload action.",
          "type": "string",
          "pattern": "^managed-evidence-(expected-[0-9a-f]{32}|(candidate|sealed|seal-receipt)-(linux-x86_64|macos-26-arm64|macos-15-arm64)-[0-9a-f]{32})$"
        },
        "uploadActionDigest": { "$ref": "#/$defs/sha256" },
        "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "receiptDigestTransport": {
      "$comment": "The trusted caller creates this post-role transport from the three reusable-workflow outputs. Semantic validation requires exactly one receipt per role, exact role-and-nonce artifact names, and equality between every transported artifact ID and the corresponding REST artifact object. The collector combines each bare uploadActionDigest with that REST object's canonical digest in origin.sealingReceiptArtifact.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "expectedIdentitySha256", "repositoryId", "workflowRunId", "runAttempt", "workflowSignerSha", "artifactNonce", "receipts"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "expectedIdentitySha256": { "$ref": "#/$defs/sha256" },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "workflowRunId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "const": 1 },
        "workflowSignerSha": { "$ref": "#/$defs/gitSha" },
        "artifactNonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "receipts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/receiptDigestTransportEntry", "properties": { "role": { "const": "linux-x86_64" }, "artifactName": { "type": "string", "pattern": "^managed-evidence-seal-receipt-linux-x86_64-[0-9a-f]{32}$" } } },
            { "$ref": "#/$defs/receiptDigestTransportEntry", "properties": { "role": { "const": "macos-26-arm64" }, "artifactName": { "type": "string", "pattern": "^managed-evidence-seal-receipt-macos-26-arm64-[0-9a-f]{32}$" } } },
            { "$ref": "#/$defs/receiptDigestTransportEntry", "properties": { "role": { "const": "macos-15-arm64" }, "artifactName": { "type": "string", "pattern": "^managed-evidence-seal-receipt-macos-15-arm64-[0-9a-f]{32}$" } } }
          ],
          "items": false
        }
      }
    },
    "receiptDigestTransportEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifactId", "artifactName", "uploadActionDigest"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": { "type": "string", "pattern": "^managed-evidence-seal-receipt-(linux-x86_64|macos-26-arm64|macos-15-arm64)-[0-9a-f]{32}$" },
        "uploadActionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "origin": {
      "$comment": "The candidatePlacement record is noncryptographic fail-closed corroboration. The attested sealing receipt supplies the sealing check-run locator and immutable facts, but no final job state. After the workflow attempt completes, the coordinator resolves exactly one job API object through sealingCheckRunId and constructs sealingJob from REST and verified provenance. Semantic validation requires sealingJob.checkRunId to equal sealingCheckRunId, distinct candidate and sealing job IDs, canonical digest equality, exact role-specific names derived from expectedIdentity.artifactNonce, one artifact per reserved name, and no other candidate, sealed, expected, or receipt artifact for that nonce.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "workflowRunId", "runAttempt", "trustAnchorSha", "testedSourceSha", "workflowSignerSha", "workflowSignerRef", "baseSha", "candidatePlacement", "sealingCheckRunId", "sealingJob", "signerWorkflow", "candidateArtifact", "sealedArtifact", "sealingReceiptArtifact", "sealingReceiptSha256", "attestationIssuer", "sealedAttestationSubjectDigest", "sealedAttestationBundleSha256", "sealedAttestationVerified", "sealingReceiptAttestationSubjectDigest", "sealingReceiptAttestationBundleSha256", "sealingReceiptAttestationVerified", "roleBundleSha256", "sealedBundleSha256", "restApiVersion", "verifiedAt"],
      "properties": {
        "repositoryId": { "type": "integer", "minimum": 1 },
        "workflowRunId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "trustAnchorSha": { "$ref": "#/$defs/gitSha" },
        "testedSourceSha": { "$ref": "#/$defs/gitSha" },
        "workflowSignerSha": { "$ref": "#/$defs/gitSha" },
        "workflowSignerRef": { "const": "refs/heads/master" },
        "baseSha": { "$ref": "#/$defs/gitSha" },
        "candidatePlacement": { "$ref": "#/$defs/candidatePlacementObservation" },
        "sealingCheckRunId": { "type": "integer", "minimum": 1 },
        "sealingJob": { "$ref": "#/$defs/sealingJobOrigin" },
        "signerWorkflow": { "$ref": "#/$defs/signerWorkflow" },
        "candidateArtifact": { "$ref": "#/$defs/artifactObservation" },
        "sealedArtifact": { "$ref": "#/$defs/artifactObservation" },
        "sealingReceiptArtifact": {
          "$comment": "The collector takes artifactId, artifactName, and uploadActionDigest from the trusted caller's receipt digest transport. It takes artifactDigest from the matching REST artifact object and requires canonical action-to-REST equality.",
          "$ref": "#/$defs/artifactObservation"
        },
        "sealingReceiptSha256": { "$ref": "#/$defs/sha256" },
        "attestationIssuer": { "const": "https://token.actions.githubusercontent.com" },
        "sealedAttestationSubjectDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sealedAttestationBundleSha256": { "$ref": "#/$defs/sha256" },
        "sealedAttestationVerified": { "const": true },
        "sealingReceiptAttestationSubjectDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sealingReceiptAttestationBundleSha256": { "$ref": "#/$defs/sha256" },
        "sealingReceiptAttestationVerified": { "const": true },
        "roleBundleSha256": {
          "$comment": "Digest of the unchanged inner ci-role-evidence.tar.zst candidate bundle.",
          "$ref": "#/$defs/sha256"
        },
        "sealedBundleSha256": {
          "$comment": "Digest of the sealed bundle, which contains only the unchanged role bundle. The separate sealing receipt contains this digest, avoiding self-reference. The aggregator must require sealedAttestationSubjectDigest to equal sha256: followed by this value, and sealingReceiptAttestationSubjectDigest to equal sha256: followed by sealingReceiptSha256.",
          "$ref": "#/$defs/sha256"
        },
        "restApiVersion": { "const": "2026-03-10" },
        "verifiedAt": { "$ref": "#/$defs/rfc3339" }
      }
    },
    "enrichedRoleEvidence": {
      "$comment": "Semantic validation requires manifest.roleEvidence.evidenceClasses and the exact gates key set to equal manifest.expectedIdentity.requiredEvidenceClasses for that role. Every gate must be true. Accepted aggregation rejects both missing assigned classes and unassigned extra classes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "manifestSha256", "origin"],
      "properties": {
        "manifest": { "$ref": "ci-role-evidence.schema.json" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "origin": { "$ref": "#/$defs/origin" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "linux-x86_64" } } } } } } },
          "then": { "properties": { "origin": { "type": "object", "properties": {
            "signerWorkflow": { "type": "object", "properties": {
              "workflowPath": { "const": ".github/workflows/ci-role-linux-x86-64.yml" },
              "jobWorkflowRef": { "const": "SkrOYC/burlmd/.github/workflows/ci-role-linux-x86-64.yml@refs/heads/master" },
              "builderId": { "const": "https://github.com/SkrOYC/burlmd/.github/workflows/ci-role-linux-x86-64.yml@refs/heads/master" }
            } },
            "candidatePlacement": { "type": "object", "properties": { "workflowJobKey": { "const": "candidate" }, "workflowPath": { "const": ".github/workflows/ci-role-linux-x86-64.yml" }, "expectedRunnerLabel": { "const": "ubuntu-24.04" }, "runnerLabels": { "type": "array", "contains": { "const": "ubuntu-24.04" }, "not": { "contains": { "const": "self-hosted" } } } } },
            "sealingJob": { "type": "object", "properties": { "workflowJobKey": { "const": "seal" }, "runnerLabels": { "type": "array", "contains": { "const": "ubuntu-24.04" }, "not": { "contains": { "const": "self-hosted" } } } } },
            "candidateArtifact": { "type": "object", "properties": { "artifactName": { "type": "string", "pattern": "^managed-evidence-candidate-linux-x86_64-[0-9a-f]{32}$" } } },
            "sealedArtifact": { "type": "object", "properties": { "artifactName": { "type": "string", "pattern": "^managed-evidence-sealed-linux-x86_64-[0-9a-f]{32}$" } } },
            "sealingReceiptArtifact": { "type": "object", "properties": { "artifactName": { "type": "string", "pattern": "^managed-evidence-seal-receipt-linux-x86_64-[0-9a-f]{32}$" } } }
          } } } }
        },
        {
          "if": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "macos-26-arm64" } } } } } } },
          "then": { "properties": { "origin": { "type": "object", "properties": {
            "signerWorkflow": { "type": "object", "properties": {
              "workflowPath": { "const": ".github/workflows/ci-role-macos-26-arm64.yml" },
              "jobWorkflowRef": { "const": "SkrOYC/burlmd/.github/workflows/ci-role-macos-26-arm64.yml@refs/heads/master" },
              "builderId": { "const": "https://github.com/SkrOYC/burlmd/.github/workflows/ci-role-macos-26-arm64.yml@refs/heads/master" }
            } },
            "candidatePlacement": { "type": "object", "properties": { "workflowJobKey": { "const": "candidate" }, "workflowPath": { "const": ".github/workflows/ci-role-macos-26-arm64.yml" }, "expectedRunnerLabel": { "const": "macos-26" }, "runnerLabels": { "type": "array", "contains": { "const": "macos-26" }, "not": { "contains": { "const": "self-hosted" } } } } },
            "sealingJob": { "type": "object", "properties": { "workflowJobKey": { "const": "seal" }, "runnerLabels": { "type": "array", "contains": { "const": "macos-26" }, "not": { "contains": { "const": "self-hosted" } } } } },
            "candidateArtifact": { "type": "object", "properties": { "artifactName": { "type": "string", "pattern": "^managed-evidence-candidate-macos-26-arm64-[0-9a-f]{32}$" } } },
            "sealedArtifact": { "type": "object", "properties": { "artifactName": { "type": "string", "pattern": "^managed-evidence-sealed-macos-26-arm64-[0-9a-f]{32}$" } } },
            "sealingReceiptArtifact": { "type": "object", "properties": { "artifactName": { "type": "string", "pattern": "^managed-evidence-seal-receipt-macos-26-arm64-[0-9a-f]{32}$" } } }
          } } } }
        },
        {
          "if": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "macos-15-arm64" } } } } } } },
          "then": { "properties": { "origin": { "type": "object", "properties": {
            "signerWorkflow": { "type": "object", "properties": {
              "workflowPath": { "const": ".github/workflows/ci-role-macos-15-arm64.yml" },
              "jobWorkflowRef": { "const": "SkrOYC/burlmd/.github/workflows/ci-role-macos-15-arm64.yml@refs/heads/master" },
              "builderId": { "const": "https://github.com/SkrOYC/burlmd/.github/workflows/ci-role-macos-15-arm64.yml@refs/heads/master" }
            } },
