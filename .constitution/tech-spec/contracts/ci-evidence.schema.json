{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burlmd.local/schemas/ci-evidence.schema.json",
  "title": "burlmd managed CI aggregate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedIdentity", "expectedIdentitySha256", "generatedAt", "mode", "status", "roleEvidence", "aggregationChecks", "rejectionReasons"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "expectedIdentity": { "$ref": "ci-role-evidence.schema.json#/$defs/expectedIdentity" },
    "expectedIdentitySha256": { "$ref": "#/$defs/sha256" },
    "generatedAt": { "$ref": "#/$defs/rfc3339" },
    "mode": { "enum": ["coordinator-job", "authenticated-local"] },
    "status": { "enum": ["accepted", "rejected"] },
    "roleEvidence": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/enrichedRoleEvidence" } },
    "aggregationChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rolesComplete", "identityCompared", "roleResultsPassed", "originAuthenticated", "artifactIntegrityVerified", "imageVersionsCompatible"],
      "properties": {
        "rolesComplete": { "type": "boolean" },
        "identityCompared": { "type": "boolean" },
        "roleResultsPassed": { "type": "boolean" },
        "originAuthenticated": { "type": "boolean" },
        "artifactIntegrityVerified": { "type": "boolean" },
        "imageVersionsCompatible": { "type": "boolean" }
      }
    },
    "rejectionReasons": { "type": "array", "items": { "$ref": "#/$defs/rejectionReason" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "roleEvidence": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              { "contains": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": {
                "role": { "const": "linux-x86_64" },
                "viewport": { "type": "object", "properties": { "verified": { "const": true } } },
                "gates": { "type": "object", "properties": { "commonFunctional": { "const": true }, "performance": { "const": true }, "linuxExactVisual": { "const": true }, "macosAuthoritativeVisual": { "const": false } } }
              } } } } } } },
              { "contains": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": {
                "role": { "const": "macos-26-arm64" },
                "viewport": { "type": "object", "properties": { "verified": { "const": true } } },
                "gates": { "type": "object", "properties": { "commonFunctional": { "const": true }, "performance": { "const": true }, "linuxExactVisual": { "const": false }, "macosAuthoritativeVisual": { "const": true } } }
              } } } } } } },
              { "contains": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": {
                "role": { "const": "macos-15-arm64" },
                "viewport": { "type": "object", "properties": { "verified": { "const": true } } },
                "gates": { "type": "object", "properties": { "commonFunctional": { "const": true }, "performance": { "const": false }, "linuxExactVisual": { "const": false }, "macosAuthoritativeVisual": { "const": false } } }
              } } } } } } }
            ]
          },
          "aggregationChecks": { "type": "object", "properties": {
            "rolesComplete": { "const": true },
            "identityCompared": { "const": true },
            "roleResultsPassed": { "const": true },
            "originAuthenticated": { "const": true },
            "artifactIntegrityVerified": { "const": true },
            "imageVersionsCompatible": { "const": true }
          } },
          "rejectionReasons": { "type": "array", "maxItems": 0 }
        }
      },
      "else": { "properties": { "rejectionReasons": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rfc3339": {
      "$comment": "The aggregator must parse this value and reject impossible calendar dates; this pattern checks shape only.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "role": { "enum": ["linux-x86_64", "macos-26-arm64", "macos-15-arm64"] },
    "signerWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowPath", "jobWorkflowRef", "jobWorkflowSha", "builderId"],
      "properties": {
        "workflowPath": { "type": "string", "minLength": 1 },
        "jobWorkflowRef": { "type": "string", "minLength": 1 },
        "jobWorkflowSha": { "$ref": "#/$defs/gitSha" },
        "builderId": { "type": "string", "pattern": "^https://github\\.com/SkrOYC/burlmd/\\.github/workflows/.+@[0-9a-f]{40}$" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "workflowRunId", "runAttempt", "headSha", "signerWorkflow", "workflowJobLabels", "attestationIssuer", "attestationSubjectDigest", "attestationBundleSha256", "attestationVerified", "artifactId", "artifactDigest", "restApiVersion", "verifiedAt"],
      "properties": {
        "repositoryId": { "type": "integer", "minimum": 1 },
        "workflowRunId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "signerWorkflow": { "$ref": "#/$defs/signerWorkflow" },
        "workflowJobLabels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "attestationIssuer": { "const": "https://token.actions.githubusercontent.com" },
        "attestationSubjectDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "attestationBundleSha256": { "$ref": "#/$defs/sha256" },
        "attestationVerified": { "const": true },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "restApiVersion": { "const": "2026-03-10" },
        "verifiedAt": { "$ref": "#/$defs/rfc3339" }
      }
    },
    "enrichedRoleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "manifestSha256", "origin"],
      "properties": {
        "manifest": { "$ref": "ci-role-evidence.schema.json" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "origin": { "$ref": "#/$defs/origin" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "linux-x86_64" } } } } } } },
          "then": { "properties": { "origin": { "type": "object", "properties": {
            "signerWorkflow": { "type": "object", "properties": {
              "workflowPath": { "const": ".github/workflows/ci-role-linux-x86-64.yml" },
              "jobWorkflowRef": { "type": "string", "pattern": "^SkrOYC/burlmd/\\.github/workflows/ci-role-linux-x86-64\\.yml@[0-9a-f]{40}$" },
              "builderId": { "type": "string", "pattern": "^https://github\\.com/SkrOYC/burlmd/\\.github/workflows/ci-role-linux-x86-64\\.yml@[0-9a-f]{40}$" }
            } },
            "workflowJobLabels": { "type": "array", "contains": { "const": "ubuntu-24.04" } }
          } } } }
        },
        {
          "if": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "macos-26-arm64" } } } } } } },
          "then": { "properties": { "origin": { "type": "object", "properties": {
            "signerWorkflow": { "type": "object", "properties": {
              "workflowPath": { "const": ".github/workflows/ci-role-macos-26-arm64.yml" },
              "jobWorkflowRef": { "type": "string", "pattern": "^SkrOYC/burlmd/\\.github/workflows/ci-role-macos-26-arm64\\.yml@[0-9a-f]{40}$" },
              "builderId": { "type": "string", "pattern": "^https://github\\.com/SkrOYC/burlmd/\\.github/workflows/ci-role-macos-26-arm64\\.yml@[0-9a-f]{40}$" }
            } },
            "workflowJobLabels": { "type": "array", "contains": { "const": "macos-26" } }
          } } } }
        },
        {
          "if": { "type": "object", "properties": { "manifest": { "type": "object", "properties": { "roleEvidence": { "type": "object", "properties": { "role": { "const": "macos-15-arm64" } } } } } } },
          "then": { "properties": { "origin": { "type": "object", "properties": {
            "signerWorkflow": { "type": "object", "properties": {
              "workflowPath": { "const": ".github/workflows/ci-role-macos-15-arm64.yml" },
              "jobWorkflowRef": { "type": "string", "pattern": "^SkrOYC/burlmd/\\.github/workflows/ci-role-macos-15-arm64\\.yml@[0-9a-f]{40}$" },
              "builderId": { "type": "string", "pattern": "^https://github\\.com/SkrOYC/burlmd/\\.github/workflows/ci-role-macos-15-arm64\\.yml@[0-9a-f]{40}$" }
            } },
            "workflowJobLabels": { "type": "array", "contains": { "const": "macos-15" } }
          } } } }
        }
      ]
    },
    "rejectionReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "enum": ["expected-identity-invalid", "role-manifest-invalid", "missing-role", "duplicate-role", "unexpected-role", "role-gate-failed", "identity-mismatch", "stale-evidence", "workflow-signer-mismatch", "runner-label-mismatch", "untrusted-origin", "attestation-unavailable", "artifact-api-mismatch", "artifact-corrupt", "mixed-image-version", "aggregation-error"] },
        "role": { "$ref": "#/$defs/role" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
