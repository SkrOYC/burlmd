{
  "contract": "spike-result claimed evidence reconciliation",
  "collectorRequirement": "Map each run to its authenticated role bundle, reconcile host.profile.runnerLabel to that role, and require claimedEvidenceClasses to equal expectedIdentity.requiredEvidenceClasses[role] in the declared order.",
  "cases": [
    {
      "name": "macos-26-packaging-only-false-accepted",
      "authenticatedRole": "macos-26-arm64",
      "expectedIdentityClasses": ["packaging-runtime", "repeatable-construction"],
      "claimedEvidenceClasses": ["packaging-runtime", "repeatable-construction"],
      "logicalViewportVerified": false,
      "expectedOutcome": "accepted"
    },
    {
      "name": "performance-claim-omits-assigned-performance",
      "authenticatedRole": "linux-x86_64",
      "expectedIdentityClasses": ["common-functional", "performance", "asset-measurement"],
      "claimedEvidenceClasses": ["common-functional", "asset-measurement"],
      "logicalViewportVerified": false,
      "expectedOutcome": "rejected:evidence-profile-mismatch"
    },
    {
      "name": "packaging-claim-adds-unassigned-performance",
      "authenticatedRole": "macos-26-arm64",
      "expectedIdentityClasses": ["packaging-runtime", "repeatable-construction"],
      "claimedEvidenceClasses": ["packaging-runtime", "repeatable-construction", "performance"],
      "logicalViewportVerified": true,
      "expectedOutcome": "rejected:evidence-profile-mismatch"
    },
    {
      "name": "packaging-claim-reorders-assigned-profile",
      "authenticatedRole": "macos-26-arm64",
      "expectedIdentityClasses": ["packaging-runtime", "repeatable-construction"],
      "claimedEvidenceClasses": ["repeatable-construction", "packaging-runtime"],
      "logicalViewportVerified": false,
      "expectedOutcome": "rejected:evidence-profile-mismatch"
    },
    {
      "name": "macos-26-claim-uses-macos-15-profile",
      "authenticatedRole": "macos-26-arm64",
      "expectedIdentityClasses": ["packaging-runtime", "repeatable-construction"],
      "claimedEvidenceClasses": ["packaging-runtime-compatibility"],
      "logicalViewportVerified": false,
      "expectedOutcome": "rejected:evidence-profile-mismatch"
    }
  ]
}
