# --- Nix / devenv ---------------------------------------------------------
.devenv/
.devenv.flake.nix
devenv.local.nix
.direnv/
# Autogenerated symlink managed by devenv's git-hooks integration.
.pre-commit-config.yaml
result
result-*

# Paths that deliberately hold nothing, so that Flutter's discovery of
# out-of-scope targets (Android SDK, Chrome) resolves the same way on every
# machine instead of picking up whatever the host happens to have. See devenv.nix.
.sentinels/
# Android state, should a future SDK pin put it here rather than in ~/.android.
.android/

# --- Rust -----------------------------------------------------------------
# Unanchored, so a Cargo workspace root moving to the repository root is still
# covered.
target/
**/*.rs.bk

# --- Flutter / Dart -------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
# Anchored: Flutter's build output lives at the root, and an unanchored pattern
# would also swallow any source directory named `build` at any depth.
/build/
.pub-cache/
.pub/
*.iml
doc/api/

# --- Platform build artifacts ---------------------------------------------
# `flutter create` writes its own per-platform .gitignore files, which stay
# authoritative. These entries are only a safety net for a tree where those
# files have not been generated yet. Note that generated plugin registrants are
# deliberately NOT ignored: upstream tracks them, and the platform projects
# reference them, so ignoring them breaks a fresh clone before `flutter pub get`.
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
android/.gradle/
android/local.properties
ios/Flutter/ephemeral/
ios/Pods/

# --- Secrets --------------------------------------------------------------
# EPIC-C introduces GitHub OAuth credentials; signing material follows if the
# mobile targets are ever unshelved.
# `.env*` rather than `.env`/`*.env`: the latter pair misses the shapes that
# actually leak — .env.local, .env.production, .env.development. The negation is
# load-bearing, since .envrc is this repo's direnv entrypoint and must stay
# tracked.
.env*
!.envrc
secrets.*
*.jks
*.keystore
key.properties

# --- Manual-QA smoke screenshots (SHEL-E001) --------------------------------
# PNGs must never be committed; a repository whose premise is readable
# plaintext diffs should not accumulate binary artifacts. See
# scripts/smoke-shot.sh.
.qa/

# --- Local / editor -------------------------------------------------------
.vscode/
.idea/
# Anchored, so log fixtures under rust/tests/ or test/ are not swallowed once
# the sync and conflict-resolution suites grow them.
/*.log
.DS_Store
