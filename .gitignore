# --- Nix / devenv ---------------------------------------------------------
.devenv/
.devenv.flake.nix
devenv.local.nix
.direnv/
# Autogenerated symlink managed by devenv's git-hooks integration.
.pre-commit-config.yaml
result
result-*

# The android module points ANDROID_USER_HOME/ANDROID_AVD_HOME at the repo so
# that AVDs and SDK state stay per-project instead of leaking into ~/.android.
.android/
# Regenerated on every shell entry, and contains absolute /nix/store paths that
# change with each devenv update. Generated state, never tracked.
/local.properties

# --- Rust -----------------------------------------------------------------
# Unanchored, so a Cargo workspace root moving to the repository root is still
# covered.
target/
**/*.rs.bk

# --- Flutter / Dart -------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
# Anchored: Flutter's build output lives at the root, and an unanchored pattern
# would also swallow any source directory named `build` at any depth.
/build/
.pub-cache/
.pub/
*.iml
doc/api/

# --- Platform build artifacts ---------------------------------------------
# `flutter create` writes its own per-platform .gitignore files, which stay
# authoritative. These entries are only a safety net for a tree where those
# files have not been generated yet. Note that generated plugin registrants are
# deliberately NOT ignored: upstream tracks them, and the platform projects
# reference them, so ignoring them breaks a fresh clone before `flutter pub get`.
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
android/.gradle/
android/local.properties
ios/Flutter/ephemeral/
ios/Pods/

# --- Secrets --------------------------------------------------------------
# EPIC-C introduces GitHub OAuth credentials; signing material follows if the
# mobile targets are ever unshelved.
.env
*.env
secrets.*
*.jks
*.keystore
key.properties

# --- Local / editor -------------------------------------------------------
.vscode/
.idea/
*.log
.DS_Store
